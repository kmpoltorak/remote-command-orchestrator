# Secrets used by the example inventories and jobs. RCO never reads this file:
# copy it to .env (git-ignored), fill it in, and load it into your shell with
#   set -a; . ./.env; set +a

# examples/inventories/prod/hosts.yaml
DEPLOY_KEY_PASSPHRASE=
DEPLOY_SUDO_PASSWORD=
LEGACY_PASSWORD=

# examples/inventories/dev/hosts.yaml
DEV_PASSWORD=

# examples/jobs/create-db-user: --var-env db_password=DB_PASSWORD
DB_PASSWORD=
